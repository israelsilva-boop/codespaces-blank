                rankTitle.textContent = "Trainee no Trânsito (Refaça o Teste)";
                rankTitle.className = "font-orbitron text-2xl md:text-3xl font-black text-red-400";
                rankDesc.textContent = "Sua pontuação ficou abaixo do necessário. Não desanime! Estude os conteúdos pedagógicos e refaça o quiz para garantir sua segurança.";
            }

            // Exibe estatísticas por categoria
            const statsContainer = document.getElementById('category-stats-container');
            statsContainer.innerHTML = '';

            for (const [catName, catData] of Object.entries(categoryStats)) {
                const catPercent = catData.total > 0 ? Math.round((catData.correct / catData.total) * 100) : 0;
                
                const statBox = document.createElement('div');
                statBox.className = "bg-slate-900/80 p-3 rounded-xl border border-gray-800 space-y-1.5";
                statBox.innerHTML = `
                    <div class="flex justify-between items-center text-xs font-orbitron">
                        <span class="font-bold text-gray-300">${catName}</span>
                        <span class="text-kcyan font-bold">${catData.correct}/${catData.total} (${catPercent}%)</span>
                    </div>
                    <div class="w-full bg-slate-950 h-2 rounded-full overflow-hidden">
                        <div class="bg-gradient-to-r from-kpink to-kcyan h-full rounded-full" style="width: ${catPercent}%"></div>
                    </div>
                `;
                statsContainer.appendChild(statBox);
            }

            showScreen('results-screen');
        }

        // =========================================================================
        // CARREGAMENTO INICIAL DA PÁGINA
        // =========================================================================
        window.onload = function() {
            // Inicializa a aba de estudo padrão
            switchStudyTab('defensiva');
            // Mostra a tela inicial
            showScreen('home-screen');
        };
    </script>
</body>
</html>