        // =========================================================================
        // LOGICA DE RENDERIZAÇÃO DO QUIZ
        // =========================================================================
        function renderQuestion() {
            const q = shuffledQuestions[currentQuestionIndex];
            const total = shuffledQuestions.length;

            // Atualiza cabeçalho e progresso
            document.getElementById('quiz-category-badge').textContent = q.category.toUpperCase();
            document.getElementById('quiz-counter').textContent = `Questão ${currentQuestionIndex + 1} de ${total}`;
            const percent = ((currentQuestionIndex + 1) / total) * 100;
            document.getElementById('quiz-progress-bar').style.width = `${percent}%`;

            // Enunciado
            document.getElementById('question-text').textContent = `${currentQuestionIndex + 1}. ${q.question}`;

            // Contêiner de Opções
            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            const previousAnswer = userAnswers[currentQuestionIndex];
            const letters = ['A', 'B', 'C', 'D'];

            q.options.forEach((optText, index) => {
                const btn = document.createElement('button');
                btn.className = `w-full text-left p-4 rounded-xl font-poppins text-xs md:text-sm transition flex items-center gap-3 border glass-panel hover:border-kcyan/60`;

                // Aplica estilos caso a questão já tenha sido respondida previamente
                if (previousAnswer !== null) {
                    if (index === q.correctIndex) {
                        btn.classList.add('border-green-400', 'bg-green-500/20', 'text-green-300', 'font-bold');
                    } else if (index === previousAnswer.selectedIndex && !previousAnswer.isCorrect) {
                        btn.classList.add('border-red-500', 'bg-red-500/20', 'text-red-300');
                    } else {
                        btn.classList.add('opacity-50', 'border-gray-800');
                    }
                } else {
                    btn.classList.add('border-gray-800', 'hover:bg-slate-800/80', 'text-gray-200');
                }

                btn.onclick = () => selectOption(index);

                btn.innerHTML = `
                    <span class="w-8 h-8 rounded-lg bg-slate-900 border border-white/20 font-orbitron font-bold flex items-center justify-center shrink-0 ${previousAnswer !== null && index === q.correctIndex ? 'text-green-400 border-green-400' : 'text-kcyan'}">
                        ${letters[index]}
                    </span>
                    <span class="flex-grow">${optText}</span>
                `;

                optionsContainer.appendChild(btn);
            });

            // Feedback Pedagógico
            const feedbackBox = document.getElementById('feedback-box');
            if (previousAnswer !== null) {
                feedbackBox.classList.remove('hidden');
                const titleEl = document.getElementById('feedback-title');
                const textEl = document.getElementById('feedback-text');

                if (previousAnswer.isCorrect) {
                    feedbackBox.className = "p-4 rounded-xl border border-green-500/50 bg-green-950/40 space-y-1 animate-fade-in";
                    titleEl.className = "flex items-center gap-2 font-orbitron font-bold text-sm text-green-400";
                    titleEl.innerHTML = `<i class="fa-solid fa-circle-check text-base"></i> Resposta Correta! (Debut Perfeito)`;
                } else {
                    feedbackBox.className = "p-4 rounded-xl border border-red-500/50 bg-red-950/40 space-y-1 animate-fade-in";
                    titleEl.className = "flex items-center gap-2 font-orbitron font-bold text-sm text-red-400";
                    titleEl.innerHTML = `<i class="fa-solid fa-circle-xmark text-base"></i> Resposta Incorreta`;
                }

                textEl.textContent = q.explanation;
            } else {
                feedbackBox.classList.add('hidden');
            }

            // Atualiza estados dos botões de navegação
            const btnPrev = document.getElementById('btn-prev');
            const btnNext = document.getElementById('btn-next');

            // Botão Anterior
            if (currentQuestionIndex === 0) {
                btnPrev.disabled = true;
                btnPrev.classList.add('opacity-40', 'cursor-not-allowed');
            } else {
                btnPrev.disabled = false;
                btnPrev.classList.remove('opacity-40', 'cursor-not-allowed');
            }

            // Botão Próxima só desbloqueia se já tiver respondido a questão atual
            if (previousAnswer !== null) {
                btnNext.disabled = false;
                btnNext.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-gray-700');
                btnNext.classList.add('glow-button-cyan', 'bg-kcyan', 'text-slate-900');

                if (currentQuestionIndex === total - 1) {
                    btnNext.innerHTML = `Finalizar Quiz <i class="fa-solid fa-flag-checkered"></i>`;
                } else {
                    btnNext.innerHTML = `Próxima <i class="fa-solid fa-chevron-right"></i>`;
                }
            } else {
                btnNext.disabled = true;
                btnNext.classList.add('opacity-50', 'cursor-not-allowed', 'bg-gray-700');
                btnNext.classList.remove('glow-button-cyan', 'bg-kcyan', 'text-slate-900');
                btnNext.innerHTML = `Próxima <i class="fa-solid fa-chevron-right"></i>`;
            }
        }

        // =========================================================================
        // MANIPULAÇÃO DA SELEÇÃO DE RESPOSTA
        // =========================================================================
        function selectOption(index) {
            // Permite responder ou alterar a resposta antes de prosseguir
            const q = shuffledQuestions[currentQuestionIndex];
            const isCorrect = (index === q.correctIndex);

            userAnswers[currentQuestionIndex] = {
                selectedIndex: index,
                isCorrect: isCorrect
            };

            // Efeito visual de confete leve se acertar de primeira
            if (isCorrect && typeof confetti === 'function') {
                confetti({
                    particleCount: 35,
                    spread: 60,
                    origin: { y: 0.7 },
                    colors: ['#FF007F', '#00F0FF', '#FFE600']
                });
            }

            // Re-renderiza para atualizar cores e desbloquear o botão "Próxima"
            renderQuestion();
        }

        function nextQuestion() {
            if (currentQuestionIndex < shuffledQuestions.length - 1) {
                currentQuestionIndex++;
                renderQuestion();
                window.scrollTo({ top: 100, behavior: 'smooth' });
            } else {
                calculateAndShowResults();
            }
        }

        function prevQuestion() {
            if (currentQuestionIndex > 0) {
                currentQuestionIndex--;
                renderQuestion();
                window.scrollTo({ top: 100, behavior: 'smooth' });
            }
        }

