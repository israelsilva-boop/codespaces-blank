        // =========================================================================
        // UTILITÁRIO: EMBARALHAMENTO FISCHER-YATES COM MANUTENÇÃO DO ÍNDICE CORRETO
        // =========================================================================
        function prepareShuffledQuiz() {
            // Clona o banco original de questões
            let bankCopy = JSON.parse(JSON.stringify(rawQuestionBank));
            
            // Embaralha as 50 questões
            for (let i = bankCopy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [bankCopy[i], bankCopy[j]] = [bankCopy[j], bankCopy[i]];
            }

            // Para cada questão, embaralha aleatoriamente as 4 alternativas
            bankCopy.forEach(q => {
                const correctText = q.options[q.correctIndex];
                
                // Embaralha o array de opções
                for (let i = q.options.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [q.options[i], q.options[j]] = [q.options[j], q.options[i]];
                }
                
                // Atualiza o novo correctIndex da opção correta embaralhada
                q.correctIndex = q.options.indexOf(correctText);
            });

            shuffledQuestions = bankCopy;
            userAnswers = new Array(shuffledQuestions.length).fill(null);
            currentQuestionIndex = 0;
        }

